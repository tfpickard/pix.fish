[Unit]
Description=pix.fish characters cron (one-shot HTTP hit, replaces Vercel cron "47 */6 * * *")

[Service]
Type=oneshot
User=pixfish
Group=pixfish
EnvironmentFile=/etc/pixfish.env
ExecStart=/usr/bin/curl -fsS -X GET -H "Authorization: Bearer ${CRON_SECRET}" http://127.0.0.1:3000/api/cron/characters
