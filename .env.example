# Neon Postgres (from Vercel integration or https://neon.tech)
POSTGRES_URL=

# Vercel Blob read/write token (from Vercel dashboard -> Storage -> Blob)
BLOB_READ_WRITE_TOKEN=

# Auth.js v5
# openssl rand -hex 32
# Doubly load-bearing: Auth.js session signing AND the PBKDF2 root used to
# encrypt per-user BYO provider keys (provider_keys table). Rotating it
# invalidates every stored provider key.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth App
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth (optional -- the "continue with Google" button only renders
# when both are set). Google Cloud Console -> APIs & Services -> Credentials
# -> OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Sign in with Apple (optional -- the "continue with Apple" button only renders
# when both are set). AUTH_APPLE_ID is your Services ID; AUTH_APPLE_SECRET is
# the client-secret JWT signed with your Apple private key (it expires -- max 6
# months -- so it must be regenerated periodically).
# Return URL: http://localhost:3000/api/auth/callback/apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Numeric GitHub user id of the bootstrap site admin. Look it up at
# https://api.github.com/users/<username>. This user is stamped role='admin'
# on first sign-in (taxonomy, prompts, ai_config, global /about, etc.). It is
# NOT an upload allowlist: any signed-in GitHub user can upload their own
# images now. Per-resource edit/delete is gated by ownership (admins override).
OWNER_GITHUB_ID=

# AI providers (env-var fallback for the bootstrap deployment)
# Users can supply their own keys via /admin/keys (stored encrypted in
# provider_keys); when a user has no row, the app falls back to these env vars.
ANTHROPIC_API_KEY=
# Optional. Powers caption embeddings (text-embedding-3-small) and therefore
# search, "more like this", the breed tool, and the UMAP atlas. Without it
# uploads still succeed but embeddings stay null.
OPENAI_API_KEY=
# Optional. Voyage multimodal-3.5 -- visual identity embeddings of character
# crops (how a figure LOOKS, not how it's described). Enables the 'visual' and
# 'blend' clustering modes on /admin/characters; without it crops carry only the
# text vec and clustering stays on 'text'. Backfill existing crops with
# `bun run characters:backfill-visuals`.
VOYAGE_API_KEY=

# Background job queue. Gates GET/POST /api/cron/jobs (Bearer token). The
# queue drains enrichment, reprocess, umap, webhook, and backup jobs; without
# this set the cron is a no-op and uploads never gain captions.
# openssl rand -hex 32
CRON_SECRET=

# Outbound X dispatch (src/lib/dispatch/). A daily job picks one specimen, rides
# a currently-trending topic, and generates a caption that never addresses it.
# Trends come from Google Trends' public RSS feed, which needs no credentials.
#
# Dry run is the default and stays the default: the job assembles the whole
# would-be post, logs it to the event canon, and posts nothing. Reviewable at
# /admin/dispatch or via `bun run dispatch:dryrun`.
#
# Live posting requires X_DISPATCH_LIVE=true AND all four X credentials below.
# Either one missing means dry run -- a deployment with the switch on but no
# credentials degrades to a reviewable draft rather than failing.
X_DISPATCH_LIVE=
#
# X (Twitter) app credentials, OAuth 1.0a user context. From the X developer
# portal: create an app, set its permissions to Read and Write, then generate
# BOTH the consumer keys and an access token/secret for the account that will
# post. Regenerate the access token after changing permissions -- a token minted
# while the app was read-only stays read-only and posts fail with a 403 that
# does not mention permissions.
#
# 1.0a rather than OAuth 2.0 because both endpoints this uses accept it and it
# needs no refresh flow, no callback route and no token storage for what is a
# single fixed account.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Optional. Sets the post's made_with_ai label. Leave UNSET to assert nothing --
# sending false is as much a claim about the image's provenance as true is.
# Only set it if it is true of the whole corpus.
X_DISPATCH_MADE_WITH_AI=
# Optional. Caption length ceiling including the hashtag, default 280 (the
# non-Premium X limit), clamped to 4000. Raise this only if the account has
# Premium -- the drift variant reads better with room to wander.
X_DISPATCH_CHAR_BUDGET=

# SEO
# Canonical origin without trailing slash. Used for sitemap, robots, JSON-LD,
# og:image absolute URLs, and Twitter cards. Falls back to https://pix.fish
# when unset; set this explicitly in production via `vercel env add`.
NEXT_PUBLIC_SITE_URL=https://pix.fish
# Optional: Search Console / Bing Webmaster ownership verification codes.
# Paste just the `content` value from the HTML verification tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Rate limiting (edge middleware -- see docs/rate-limiting.md)
# Both optional. This layer is a backstop that keeps a hammering client from
# reaching the page render; the load-bearing limiter is a Vercel WAF rule,
# which is configured on the project, not here.
# Per-IP requests per minute. Default 200.
RATE_LIMIT_RPM=
# Set to 1 to switch the edge limiter off without a deploy.
RATE_LIMIT_DISABLED=
